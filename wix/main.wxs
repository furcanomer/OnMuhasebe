<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <?define Manufacturer = "furcanomer" ?>
  <?define ProductName = "On Muhasebe" ?>
  <?define UpgradeCode = "B5E3F1A2-9C4D-4E8B-8F6A-1D2E3C4B5A69" ?>
  <?define BinDir = "$(var.CargoTargetBinDir)" ?>
  <?define MainBinary = "OnMuhasebe.exe" ?>

  <Product Id="*"
           Name="$(var.ProductName)"
           Language="1055"
           Version="$(var.CargoPackageVersion)"
           Manufacturer="$(var.Manufacturer)"
           UpgradeCode="$(var.UpgradeCode)">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Platform="x64"
             Description="On Muhasebe - Yerel Masaustu Muhasebe Programi"
             Comments="Windows 10 veya uzeri. Verileriniz yerel olarak saklanir." />

    <MajorUpgrade DowngradeErrorMessage="Daha yeni bir surum zaten kurulu. Yukseltme yapilamaz."
                  AllowSameVersionUpgrades="yes"
                  Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" />

    <Feature Id="MainFeature" Title="On Muhasebe" Level="1" Display="expand">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="OnMuhasebe">
          <Component Id="MainExecutable" Guid="7A2B3C4D-5E6F-7890-ABCD-1234567890EF">
            <File Id="OnMuhasebeExe" Source="$(var.BinDir)\$(var.MainBinary)" KeyPath="yes" />
          </Component>
          <Component Id="ReadmeFile" Guid="A1B2C3D4-E5F6-7890-ABCD-0987654321FE">
            <File Id="ReadmeMd" Source="README.md" />
          </Component>
          <Component Id="LicenseFile" Guid="C1D2E3F4-A5B6-7890-ABCD-5678901234FE">
            <File Id="LicenseTxt" Source="LICENSE" />
          </Component>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="AppMenuDir" Name="On Muhasebe">
          <Component Id="StartMenuShortcut" Guid="D1E2F3A4-B5C6-7890-ABCD-5678901234AF">
            <Shortcut Id="StartMenuShortcut"
                      Name="On Muhasebe"
                      Description="On Muhasebe"
                      Target="[INSTALLDIR]\$(var.MainBinary)"
                      WorkingDirectory="INSTALLDIR" />
            <Shortcut Id="UninstallShortcut"
                      Name="Kaldir"
                      Target="[SystemFolder]msiexec.exe"
                      Arguments="/x [ProductCode]" />
            <RemoveFolder Id="RemoveAppMenuDir" On="uninstall" />
            <RegistryValue Root="HKCU" Key="Software\OnMuhasebe" Name="installed" Type="integer" Value="1" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
      <Directory Id="DesktopFolder">
        <Component Id="DesktopShortcut" Guid="E1F2A3B4-C5D6-7890-ABCD-5678901234BA">
          <Shortcut Id="DesktopShortcut"
                    Name="On Muhasebe"
                    Description="On Muhasebe"
                    Target="[INSTALLDIR]\$(var.MainBinary)"
                    WorkingDirectory="INSTALLDIR" />
          <RegistryValue Root="HKCU" Key="Software\OnMuhasebe" Name="desktop" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </Directory>

    <ComponentGroup Id="ProductComponents" Directory="INSTALLDIR">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="ReadmeFile" />
      <ComponentRef Id="LicenseFile" />
    </ComponentGroup>

    <UIRef Id="WixUI_InstallDir" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLDIR" />

    <WixVariable Id="WixUILicenseRtf" Value="wix\LICENSE.rtf" />

    <Icon Id="ProductIcon" SourceFile="assets\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="ProductIcon" />

    <Property Id="ARPNOREPAIR" Value="1" />
  </Product>
</Wix>
